# Leave ANTHROPIC_API_KEY unset to run fully offline with the deterministic mock provider.
LLM_PROVIDER=mock           # mock | anthropic | bedrock
# ANTHROPIC_API_KEY=sk-ant-...
ROUTER_MODEL=claude-haiku-4-5
AGENT_MODEL=claude-sonnet-4-6

# DJANGO_DEBUG=1 relaxes SECRET_KEY/ALLOWED_HOSTS/CORS/BACKEND_AUTH_SECRET requirements
# for local dev only. Leave unset (or "0") anywhere the API is reachable over a network.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Must exactly match AUTH_SECRET's counterpart in web/.env.local (BACKEND_AUTH_SECRET) —
# it's the shared secret the frontend uses to sign short-lived bridge tokens for this API.
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_AUTH_SECRET=dev-only-change-me

# Comma-separated list of frontend origins allowed to call this API cross-origin when
# DJANGO_DEBUG is off, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=
