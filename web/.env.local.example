NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# Server-only secrets — never prefix these with NEXT_PUBLIC_, they must not reach the browser.
# Signs the httpOnly session cookie (web/lib/auth.ts). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=dev-only-change-me
# Must exactly match BACKEND_AUTH_SECRET in backend/.env — signs the short-lived token
# the browser presents to the Django API when dataSource is "real" (web/lib/backend-token.ts).
BACKEND_AUTH_SECRET=dev-only-change-me

# Set to 1 only in demo/sales environments — shows plaintext demo login credentials on
# the login page. Leave unset everywhere else.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=0
